Resources:
  sslSecurityGroupIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId:
        Fn::GetAtt:
          - AWSEBSecurityGroup
          - GroupId
      IpProtocol: tcp
      FromPort: 443
      ToPort: 443
      CidrIp: 0.0.0.0/0

  httpSecurityGroupIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId:
        Fn::GetAtt:
          - AWSEBSecurityGroup
          - GroupId
      IpProtocol: tcp
      FromPort: 80
      ToPort: 80
      CidrIp: 0.0.0.0/0

files:
  # 1. Inject the ACME routing rule into the native EB Nginx block
  "/etc/nginx/conf.d/elasticbeanstalk/letsencrypt.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      location /.well-known/acme-challenge/ {
          root /var/app/current/public;
          allow all;
      }

  # 2. This script runs AFTER the application and Nginx are fully online and healthy
  "/opt/elasticbeanstalk/hooks/appdeploy/post/99_sign_ssl.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      set -euo pipefail
      
      # Load environment variables
      export $(cat /opt/elasticbeanstalk/deployment/env | xargs)

      CERT_PATH="/etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem"
      if [ -f "$CERT_PATH" ]; then
        echo "Certificate already exists, skipping initialization."
        exit 0
      fi

      echo "Installing Certbot..."
      if [ ! -d "/opt/certbot" ]; then
        python3 -m venv /opt/certbot
        /opt/certbot/bin/pip install --upgrade pip
        /opt/certbot/bin/pip install certbot
        ln -sf /opt/certbot/bin/certbot /usr/bin/certbot
      fi

      echo "Creating webroot folder..."
      mkdir -p /var/app/current/public/.well-known/acme-challenge

      echo "Issuing certificate..."
      certbot certonly --webroot -w /var/app/current/public --non-interactive --agree-tos \
        --email "${CERTBOT_EMAIL}" \
        -d "${DOMAIN_NAME}"

      echo "Reloading Nginx cleanly..."
      systemctl reload nginx