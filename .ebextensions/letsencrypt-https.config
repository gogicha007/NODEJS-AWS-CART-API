Resources:
  sslSecurityGroupIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId:
        Fn::GetAtt:
          - AWSEBSecurityGroup
          - GroupId
      IpProtocol: tcp
      FromPort: 443
      ToPort: 443
      CidrIp: 0.0.0.0/0

  httpSecurityGroupIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId:
        Fn::GetAtt:
          - AWSEBSecurityGroup
          - GroupId
      IpProtocol: tcp
      FromPort: 80
      ToPort: 80
      CidrIp: 0.0.0.0/0

container_commands:
  01_validate_letsencrypt_env:
    command: |
      set -euo pipefail
      if [ -z "${DOMAIN_NAME:-}" ] || [ -z "${CERTBOT_EMAIL:-}" ]; then
        echo "ERROR: DOMAIN_NAME and CERTBOT_EMAIL environment variables are required"
        exit 1
      fi

  02_install_certbot:
    command: |
      set -euo pipefail
      if [ ! -d "/opt/certbot" ]; then
        python3 -m venv /opt/certbot
        /opt/certbot/bin/pip install --upgrade pip
        /opt/certbot/bin/pip install certbot
        ln -sf /opt/certbot/bin/certbot /usr/bin/certbot
      fi

  03_issue_certificate_once:
    command: |
      set -euo pipefail
      CERT_PATH="/etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem"

      if [ -f "$CERT_PATH" ]; then
        echo "Certificate already exists, skipping initial issuance"
        exit 0
      fi

      systemctl stop nginx
      
      certbot certonly --standalone --non-interactive --agree-tos \
        --email "${CERTBOT_EMAIL}" \
        -d "${DOMAIN_NAME}"
      
      systemctl start nginx

  04_setup_renewal_cron:
    command: |
      set -euo pipefail
      cat > /etc/cron.d/certbot-renew <<'EOF'
      17 3 * * * root systemctl stop nginx && certbot renew --quiet --non-interactive; RC=$?; systemctl start nginx; if [ $RC -eq 0 ]; then systemctl reload nginx; fi
      EOF
      chmod 644 /etc/cron.d/certbot-renew