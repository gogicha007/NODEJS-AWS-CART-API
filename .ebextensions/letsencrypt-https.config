Resources:
  sslSecurityGroupIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId:
        Fn::GetAtt:
          - AWSEBSecurityGroup
          - GroupId
      IpProtocol: tcp
      FromPort: 443
      ToPort: 443
      CidrIp: 0.0.0.0/0

  httpSecurityGroupIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId:
        Fn::GetAtt:
          - AWSEBSecurityGroup
          - GroupId
      IpProtocol: tcp
      FromPort: 80
      ToPort: 80
      CidrIp: 0.0.0.0/0

files:
  "/etc/nginx/conf.d/letsencrypt.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      server {
          listen 80;
          server_name gogicha007-cart-api-production.eu-north-1.elasticbeanstalk.com;

          location /.well-known/acme-challenge/ {
              root /var/app/current/public;
              allow all;
          }

          location / {
              proxy_pass http://127.0.0.1:80; 
          }
      }

container_commands:
  01_validate_letsencrypt_env:
    command: |
      set -euo pipefail
      if [ -z "${DOMAIN_NAME:-}" ] || [ -z "${CERTBOT_EMAIL:-}" ]; then
        echo "ERROR: DOMAIN_NAME and CERTBOT_EMAIL environment variables are required"
        exit 1
      fi

  02_install_certbot:
    command: |
      set -euo pipefail
      if [ ! -d "/opt/certbot" ]; then
        python3 -m venv /opt/certbot
        /opt/certbot/bin/pip install --upgrade pip
        /opt/certbot/bin/pip install certbot
        ln -sf /opt/certbot/bin/certbot /usr/bin/certbot
      fi

  03_issue_certificate_webroot:
    command: |
      set -euo pipefail
      CERT_PATH="/etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem"

      if [ -f "$CERT_PATH" ]; then
        echo "Certificate already exists, skipping initial issuance"
        exit 0
      fi

      echo "Creating challenge directory..."
      mkdir -p /var/app/current/public/.well-known/acme-challenge
      
      # FIX: Bring Nginx up safely if it isn't running so Certbot can pass the challenge
      echo "Ensuring Nginx is running..."
      systemctl start nginx || systemctl restart nginx

      echo "Running Certbot in non-blocking webroot mode..."
      certbot certonly --webroot -w /var/app/current/public --non-interactive --agree-tos \
        --email "${CERTBOT_EMAIL}" \
        -d "${DOMAIN_NAME}"

  04_setup_renewal_cron:
    command: |
      set -euo pipefail
      cat > /etc/cron.d/certbot-renew <<'EOF'
      17 3 * * * root certbot renew --webroot -w /var/app/current/public --quiet --non-interactive && systemctl reload nginx
      EOF
      chmod 644 /etc/cron.d/certbot-renew