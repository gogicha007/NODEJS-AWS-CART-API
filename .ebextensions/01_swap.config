commands:
  01_setup_swap:
    command: |
      if [ ! -f /swapfile ]; then
        echo "Creating 2GB swap file..."
        dd if=/dev/zero of=/swapfile bs=1M count=2048
        chmod 600 /swapfile
        mkswap /swapfile
        swapon /swapfile
        echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
        echo "Swap allocation complete!"
      else
        echo "Swap file already exists."
      fi