files:
  /tmp/nginx-https.conf.template:
    mode: "000644"
    owner: root
    group: root
    content: |
      server {
        listen 443 ssl;
        server_name ${DOMAIN_NAME};

        ssl_certificate     /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         HIGH:!aNULL:!MD5;

        location / {
          proxy_pass         http://localhost:3000;
          proxy_http_version 1.1;
          proxy_set_header   Upgrade $http_upgrade;
          proxy_set_header   Connection 'upgrade';
          proxy_set_header   Host $host;
          proxy_set_header   X-Real-IP $remote_addr;
          proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header   X-Forwarded-Proto $scheme;
          proxy_cache_bypass $http_upgrade;
        }
      }

      # Redirect HTTP to HTTPS
      server {
        listen 80;
        server_name ${DOMAIN_NAME};
        return 301 https://$host$request_uri;
      }

container_commands:
  90_write_nginx_https_conf:
    command: |
      set -euo pipefail
      set -a
      . /opt/elasticbeanstalk/deployment/env
      set +a
      if [ "${LETSENCRYPT_ENABLED:-false}" != "true" ]; then
        echo "LETSENCRYPT_ENABLED is not true; skipping nginx HTTPS config"
        exit 0
      fi
      CERT_PATH="/etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem"
      KEY_PATH="/etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem"
      if [ ! -f "$CERT_PATH" ] || [ ! -f "$KEY_PATH" ]; then
        echo "Certificate files not found yet, skipping nginx HTTPS config write"
        exit 0
      fi
      envsubst '${DOMAIN_NAME}' < /tmp/nginx-https.conf.template > /etc/nginx/conf.d/https.conf
      nginx -t
      systemctl reload nginx
